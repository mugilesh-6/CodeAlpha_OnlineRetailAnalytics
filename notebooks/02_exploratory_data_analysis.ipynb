  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Business KPIs and Key Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"KEY BUSINESS METRICS\")\n",
    "print(\"=\"*50)\n",
    "\n",
    "# Calculate key metrics\n",
    "total_revenue = df['Revenue'].sum()\n",
    "total_orders = df['InvoiceNo'].nunique()\n",
    "total_transactions = len(df)\n",
    "total_customers = df['CustomerID'].nunique()\n",
    "total_products = df['StockCode'].nunique()\n",
    "total_countries = df['Country'].nunique()\n",
    "\n",
    "# Average metrics\n",
    "avg_order_value = df.groupby('InvoiceNo')['Revenue'].sum().mean()\n",
    "avg_transaction_value = df['Revenue'].mean()\n",
    "avg_quantity_per_transaction = df['Quantity'].mean()\n",
    "\n",
    "# Date range\n",
    "date_range_start = df['InvoiceDate'].min()\n",
    "date_range_end = df['InvoiceDate'].max()\n",
    "date_range_days = (date_range_end - date_range_start).days\n",
    "\n",
    "print(f\"📊 REVENUE & TRANSACTIONS\")\n",
    "print(f\"   Total Revenue: £{total_revenue:,.2f}\")\n",
    "print(f\"   Total Orders: {total_orders:,}\")\n",
    "print(f\"   Total Transactions: {total_transactions:,}\")\n",
    "\n",
    "print(f\"\\n👥 CUSTOMERS & PRODUCTS\")\n",
    "print(f\"   Unique Customers: {total_customers:,}\")\n",
    "print(f\"   Unique Products: {total_products:,}\")\n",
    "print(f\"   Countries Served: {total_countries}\")\n",
    "\n",
    "print(f\"\\n💰 AVERAGE VALUES\")\n",
    "print(f\"   Average Order Value: £{avg_order_value:.2f}\")\n",
    "print(f\"   Average Transaction Value: £{avg_transaction_value:.2f}\")\n",
    "print(f\"   Average Quantity per Transaction: {avg_quantity_per_transaction:.2f}\")\n",
    "\n",
    "print(f\"\\n📅 TIME PERIOD\")\n",
    "print(f\"   Date Range: {date_range_start.strftime('%Y-%m-%d')} to {date_range_end.strftime('%Y-%m-%d')}\")\n",
    "print(f\"   Analysis Period: {date_range_days} days\")\n",
    "print(f\"   Daily Average Revenue: £{total_revenue/date_range_days:,.2f}\")"
   ]
  }
 ],
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Revenue Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"REVENUE DISTRIBUTION ANALYSIS\")\n",
    "print(\"=\"*40)\n",
    "\n",
    "# Revenue statistics\n",
    "revenue_stats = df['Revenue'].describe()\n",
    "print(revenue_stats)\n",
    "\n",
    "# Positive vs negative revenue (sales vs returns)\n",
    "positive_revenue = df[df['Revenue'] > 0]['Revenue'].sum()\n",
    "negative_revenue = df[df['Revenue'] < 0]['Revenue'].sum()\n",
    "net_revenue = positive_revenue + negative_revenue\n",
    "\n",
    "print(f\"\\nRevenue Breakdown:\")\n",
    "print(f\"Positive Revenue (Sales): £{positive_revenue:,.2f}\")\n",
    "print(f\"Negative Revenue (Returns): £{negative_revenue:,.2f}\")\n",
    "print(f\"Net Revenue: £{net_revenue:,.2f}\")\n",
    "print(f\"Return Rate: {(abs(negative_revenue)/positive_revenue)*100:.2f}%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize revenue distribution\n",
    "fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n",
    "fig.suptitle('Revenue Analysis', fontsize=16, fontweight='bold')\n",
    "\n",
    "# Revenue histogram\n",
    "axes[0, 0].hist(df['Revenue'], bins=50, alpha=0.7, edgecolor='black')\n",
    "axes[0, 0].set_title('Revenue Distribution')\n",
    "axes[0, 0].set_xlabel('Revenue (£)')\n",
    "axes[0, 0].set_ylabel('Frequency')\n",
    "axes[0, 0].axvline(df['Revenue'].mean(), color='red', linestyle='--', label='Mean')\n",
    "axes[0, 0].axvline(df['Revenue'].median(), color='green', linestyle='--', label='Median')\n",
    "axes[0, 0].legend()\n",
    "\n",
    "# Revenue box plot\n",
    "axes[0, 1].boxplot(df['Revenue'])\n",
    "axes[0, 1].set_title('Revenue Box Plot')\n",
    "axes[0, 1].set_ylabel('Revenue (£)')\n",
    "\n",
    "# Revenue by transaction type\n",
    "transaction_revenue = df.groupby('TransactionType')['Revenue'].sum()\n",
    "axes[1, 0].bar(transaction_revenue.index, transaction_revenue.values, alpha=0.7)\n",
    "axes[1, 0].set_title('Revenue by Transaction Type')\n",
    "axes[1, 0].set_ylabel('Total Revenue (£)')\n",
    "axes[1, 0].tick_params(axis='x', rotation=45)\n",
    "\n",
    "# Cumulative revenue over time\n",
    "daily_revenue = df.groupby(df['InvoiceDate'].dt.date)['Revenue'].sum().cumsum()\n",
    "axes[1, 1].plot(daily_revenue.index, daily_revenue.values)\n",
    "axes[1, 1].set_title('Cumulative Revenue Over Time')\n",
    "axes[1, 1].set_xlabel('Date')\n",
    "axes[1, 1].set_ylabel('Cumulative Revenue (£)')\n",
    "axes[1, 1].tick_params(axis='x', rotation=45)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
