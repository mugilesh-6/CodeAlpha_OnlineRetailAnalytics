  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Geographic Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"GEOGRAPHIC ANALYSIS\")\n",
    "print(\"=\"*30)\n",
    "\n",
    "# Revenue by country\n",
    "country_analysis = df.groupby('Country').agg({\n",
    "    'Revenue': ['sum', 'mean', 'count'],\n",
    "    'InvoiceNo': 'nunique',\n",
    "    'CustomerID': 'nunique'\n",
    "}).round(2)\n",
    "\n",
    "country_analysis.columns = ['Total_Revenue', 'Avg_Revenue', 'Transactions', 'Orders', 'Customers']\n",
    "country_analysis = country_analysis.sort_values('Total_Revenue', ascending=False)\n",
    "\n",
    "print(\"\\n🌍 REVENUE BY COUNTRY:\")\n",
    "print(country_analysis.head(10))\n",
    "\n",
    "# Calculate country percentages\n",
    "country_analysis['Revenue_Percentage'] = (country_analysis['Total_Revenue'] / country_analysis['Total_Revenue'].sum() * 100).round(2)\n",
    "\n",
    "print(f\"\\n📊 TOP 5 COUNTRIES BY REVENUE SHARE:\")\n",
    "top_countries = country_analysis.head(5)\n",
    "for country, row in top_countries.iterrows():\n",
    "    print(f\"{country}: £{row['Total_Revenue']:,.2f} ({row['Revenue_Percentage']:.1f}%)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize geographic analysis\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
    "fig.suptitle('Geographic Analysis', fontsize=16, fontweight='bold')\n",
    "\n",
    "# Revenue by top 10 countries\n",
    "top_10_countries = country_analysis.head(10)\n",
    "axes[0, 0].barh(range(len(top_10_countries)), top_10_countries['Total_Revenue'], alpha=0.7)\n",
    "axes[0, 0].set_yticks(range(len(top_10_countries)))\n",
    "axes[0, 0].set_yticklabels(top_10_countries.index, fontsize=9)\n",
    "axes[0, 0].set_title('Top 10 Countries by Revenue')\n",
    "axes[0, 0].set_xlabel('Total Revenue (£)')\n",
    "\n",
    "# Country revenue pie chart (top 8 + others)\n",
    "top_8_countries = country_analysis.head(8)\n",
    "others_revenue = country_analysis.iloc[8:]['Total_Revenue'].sum()\n",
    "\n",
    "pie_data = list(top_8_countries['Total_Revenue']) + [others_revenue]\n",
    "pie_labels = list(top_8_countries.index) + ['Others']\n",
    "\n",
    "axes[0, 1].pie(pie_data, labels=pie_labels, autopct='%1.1f%%', startangle=90)\n",
    "axes[0, 1].set_title('Revenue Distribution by Country')\n",
    "\n",
    "# Number of customers by country\n",
    "customer_data = top_10_countries['Customers']\n",
    "axes[1, 0].bar(range(len(customer_data)), customer_data.values, alpha=0.7, color='orange')\n",
    "axes[1, 0].set_xticks(range(len(customer_data)))\n",
    "axes[1, 0].set_xticklabels(customer_data.index, rotation=45, ha='right', fontsize=9)\n",
    "axes[1, 0].set_title('Number of Customers by Country')\n",
    "axes[1, 0].set_ylabel('Number of Customers')\n",
    "\n",
    "# Average revenue per transaction by country\n",
    "avg_revenue_data = top_10_countries['Avg_Revenue']\n",
    "axes[1, 1].bar(range(len(avg_revenue_data)), avg_revenue_data.values, alpha=0.7, color='green')\n",
    "axes[1, 1].set_xticks(range(len(avg_revenue_data)))\n",
    "axes[1, 1].set_xticklabels(avg_revenue_data.index, rotation=45, ha='right', fontsize=9)\n",
    "axes[1, 1].set_title('Average Revenue per Transaction by Country')\n",
    "axes[1, 1].set_ylabel('Average Revenue (£)')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Time Series Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"TIME SERIES ANALYSIS\")\n",
    "print(\"=\"*30)\n",
    "\n",
    "# Monthly revenue trends\n",
    "monthly_revenue = df.groupby(['Year', 'Month'])['Revenue'].sum().reset_index()\n",
    "monthly_revenue['Date'] = pd.to_datetime(monthly_revenue[['Year', 'Month']].assign(day=1))\n",
    "monthly_revenue = monthly_revenue.sort_values('Date')\n",
    "\n",
    "print(\"\\n📅 MONTHLY REVENUE TRENDS:\")\n",
    "for _, row in monthly_revenue.iterrows():\n",
    "    print(f\"{row['Date'].strftime('%Y-%m')}: £{row['Revenue']:,.2f}\")\n",
    "\n",
    "# Best and worst months\n",
    "best_month = monthly_revenue.loc[monthly_revenue['Revenue'].idxmax()]\n",
    "worst_month = monthly_revenue.loc[monthly_revenue['Revenue'].idxmin()]\n",
    "\n",
    "print(f\"\\n🏆 Best Month: {best_month['Date'].strftime('%Y-%m')} (£{best_month['Revenue']:,.2f})\")\n",
    "print(f\"📉 Worst Month: {worst_month['Date'].strftime('%Y-%m')} (£{worst_month['Revenue']:,.2f})\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Time series visualizations\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
    "fig.suptitle('Time Series Analysis', fontsize=16, fontweight='bold')\n",
    "\n",
    "# Monthly revenue trend\n",
    "axes[0, 0].plot(monthly_revenue['Date'], monthly_revenue['Revenue'], marker='o', linewidth=2, markersize=6)\n",
    "axes[0, 0].set_title('Monthly Revenue Trend')\n",
    "axes[0, 0].set_xlabel('Date')\n",
    "axes[0, 0].set_ylabel('Revenue (£)')\n",
    "axes[0, 0].grid(True, alpha=0.3)\n",
    "axes[0, 0].tick_params(axis='x', rotation=45)\n",
    "\n",
    "# Revenue by day of week\n",
    "dow_revenue = df.groupby('DayName')['Revenue'].mean()\n",
    "day_order = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']\n",
    "dow_revenue = dow_revenue.reindex([d for d in day_order if d in dow_revenue.index])\n",
    "\n",
    "axes[0, 1].bar(dow_revenue.index, dow_revenue.values, alpha=0.7, color='orange')\n",
    "axes[0, 1].set_title('Average Revenue by Day of Week')\n",
    "axes[0, 1].set_ylabel('Average Revenue (£)')\n",
    "axes[0, 1].tick_params(axis='x', rotation=45)\n",
